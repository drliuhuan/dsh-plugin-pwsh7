{
  "name": "dsh-plugin-pwsh7",
  "version": "0.7.0",
  "description": "Windows DeepSeek Harness bundle that routes the pwsh tool to PowerShell 7 (or forces Windows PowerShell 5.1), lets the user pick among several installed pwsh.exe files, always redirects Remove-Item deletions to the Recycle Bin, and installs only through the official MSI (system scope) or the portable ZIP (current user) — never winget or a Microsoft Store (MSIX) copy. Includes a Settings page, a Web setup dialog with live download progress, and a sandbox-aware executor.",
  "type": "module",
  "license": "MIT",
  "author": "drliuhuan",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./pwsh-executor": "./lib/executors/pwsh.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "powershell",
    "powershell-7",
    "pwsh",
    "windows",
    "shell",
    "sandbox",
    "recycle-bin",
    "deletion-safety"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drliuhuan/dsh-plugin-pwsh7.git"
  },
  "homepage": "https://github.com/drliuhuan/dsh-plugin-pwsh7#readme",
  "bugs": {
    "url": "https://github.com/drliuhuan/dsh-plugin-pwsh7/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "npm pack --ignore-scripts"
  }
}
